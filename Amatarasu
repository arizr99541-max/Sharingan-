-- Player ESP (Chams Highlight)
local espFolder = Instance.new("Folder")
espFolder.Name = "SharinganPlayerESP"
espFolder.Parent = game:GetService("CoreGui")

local function applyPlayerESP(player)
    if player == LocalPlayer then return end
    
    local function addHighlight(char)
        if not char then return end
        local oldHL = espFolder:FindFirstChild(player.Name)
        if oldHL then oldHL:Destroy() end
        
        if UTILS_CONFIG.ESPEnabled then
            local hl = Instance.new("Highlight")
            hl.Name = player.Name
            hl.Adornee = char
            hl.FillColor = Color3.fromRGB(255, 0, 0)
            hl.OutlineColor = Color3.fromRGB(0, 0, 0)
            hl.FillTransparency = 0.3
            hl.OutlineTransparency = 0
            hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
            hl.Parent = espFolder
        end
    end
    
    if player.Character then addHighlight(player.Character) end
    player.CharacterAdded:Connect(function(char)
        task.wait(0.5)
        addHighlight(char)
    end)
end

local function togglePlayerESP(state)
    UTILS_CONFIG.ESPEnabled = state
    espFolder:ClearAllChildren()
    if state then
        for _, player in ipairs(Players:GetPlayers()) do
            applyPlayerESP(player)
        end
    end
end

Players.PlayerAdded:Connect(function(player)
    if UTILS_CONFIG.ESPEnabled then applyPlayerESP(player) end
end)

Players.PlayerRemoving:Connect(function(player)
    local oldHL = espFolder:FindFirstChild(player.Name)
    if oldHL then oldHL:Destroy() end
end)


-- Waypoint / Distance ESP (Billboard UI)
local wpFolder = Instance.new("Folder")
wpFolder.Name = "SharinganWaypointESP"
wpFolder.Parent = game:GetService("CoreGui")

local function applyWaypointESP(player)
    if player == LocalPlayer then return end
    
    local function createBillboard(char)
        if not char then return end
        local hrp = char:WaitForChild("HumanoidRootPart", 3)
        if not hrp then return end
        
        local oldBB = wpFolder:FindFirstChild(player.Name .. "_WP")
        if oldBB then oldBB:Destroy() end
        
        if UTILS_CONFIG.WaypointESPEnabled then
            local bb = Instance.new("BillboardGui")
            bb.Name = player.Name .. "_WP"
            bb.Adornee = hrp
            bb.Size = UDim2.new(0, 150, 0, 35)
            bb.AlwaysOnTop = true
            bb.Parent = wpFolder
            
            local label = Instance.new("TextLabel")
            label.Size = UDim2.new(1, 0, 1, 0)
            label.BackgroundTransparency = 1
            label.TextColor3 = Color3.fromRGB(255, 50, 50)
            label.TextStrokeTransparency = 0
            label.Font = Enum.Font.GothamBold
            label.TextSize = 12
            label.Parent = bb
            
            task.spawn(function()
                while UTILS_CONFIG.WaypointESPEnabled and char and char.Parent and hrp and hrp.Parent do
                    local myHRP = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
                    if myHRP then
                        local dist = math.floor((hrp.Position - myHRP.Position).Magnitude)
                        label.Text = string.format("👁️ [Mangekyou] %s\n[%d Studs]", player.DisplayName, dist)
                    end
                    task.wait(0.2)
                end
                bb:Destroy()
            end)
        end
    end
    
    if player.Character then createBillboard(player.Character) end
    player.CharacterAdded:Connect(function(char)
        task.wait(0.5)
        createBillboard(char)
    end)
end

local function toggleWaypointESP(state)
    UTILS_CONFIG.WaypointESPEnabled = state
    wpFolder:ClearAllChildren()
    if state then
        for _, player in ipairs(Players:GetPlayers()) do
            applyWaypointESP(player)
        end
    end
end

